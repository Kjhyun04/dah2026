# attack_agent 배포 설정 — 이 파일을 .env 로 복사 후 값 채움(.env 는 gitignore).
#   dah.sh 가 .env 를 자동 로드하고, config 의 ${VAR} 가 여기서 치환됩니다(하드코딩 0).
#   ★ 온-호스트(LocalBackend) 실행 시 TESTBED_HOST/SSH_KEY 는 미사용(ssh backend 옵션용).

# 테스트베드 접속 (온-호스트 LocalBackend 면 비워둠). ★값에 < > 금지 — bash .env 소싱이 깨짐.
#   예: TESTBED_HOST=43.203.160.4   SSH_KEY=~/.ssh/key.pem
TESTBED_HOST=
TESTBED_USER=ubuntu
SSH_KEY=

# ── LLM(AttackOrchestrator) — 키 1개 + 모델 slug 1개만 채우면 "아무 플랫폼"에서 동작 ──
#   litellm 이 모델 slug 접두로 provider 라우팅(openrouter/… · anthropic/… · openai/… · gemini/…)하고,
#   LLM_API_KEY 값을 명시 주입하므로 하나의 키로 어떤 provider 든 인증된다(로그·argv 미노출).
#   ★★ 값은 '=' 바로 뒤에 공백 없이 붙여 쓰세요. "= 뒤 공백"은 bash sourcing 오류(값이 명령으로 실행됨). 따옴표 금지.
#        올바름:  LLM_API_KEY=sk-or-abc123   /   틀림:  LLM_API_KEY= sk-or-abc123   ← '=' 뒤 공백
# 모델 slug 예) openrouter/anthropic/claude-sonnet-4 | openai/gpt-4o | gemini/gemini-2.0-flash | anthropic/claude-sonnet-4-5 (미설정 시 friendly名 기본)
LLM_MODEL=
# 키 값 1개(provider 무관). config api_key_env 기본이 이 이름을 가리킨다.
LLM_API_KEY=
#LLM_API_KEY_ENV=          # (선택) 기존 관례키 이름 재사용(예: OPENROUTER_API_KEY). 그 경우 그 이름의 키를 채우면 됨.

# 비밀값 — 서버 밖 반출 금지 (관례키 재사용 시 사용; 별도 .env.openrouter 로도 가능)
#OPENROUTER_API_KEY=
ARIA_KEY=
