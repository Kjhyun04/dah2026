# attack_agent 배포 설정 — 이 파일을 .env 로 복사 후 값 채움(.env 는 gitignore).
#   dah.sh 가 .env 를 자동 로드하고, config 의 ${VAR} 가 여기서 치환됩니다(하드코딩 0).
#   ★ 온-호스트(LocalBackend) 실행 시 TESTBED_HOST/SSH_KEY 는 미사용(ssh backend 옵션용).

# 테스트베드 접속
TESTBED_HOST=<테스트베드-IP>
TESTBED_USER=ubuntu
SSH_KEY=~/.ssh/<키>.pem

# 비밀값 — 서버 밖 반출 금지 (별도 .env.openrouter 로도 가능)
OPENROUTER_API_KEY=
ARIA_KEY=
