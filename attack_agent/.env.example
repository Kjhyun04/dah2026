# attack_agent 배포 설정 — 이 파일을 .env 로 복사 후 값 채움(.env 는 gitignore).


# 테스트베드 접속 (온-호스트 LocalBackend 면 비워둠).
#   예: TESTBED_HOST=43.203.160.4   SSH_KEY=~/.ssh/key.pem
TESTBED_HOST= # 선택 사항
TESTBED_USER=ubuntu
SSH_KEY= # 선택 사항



# 모델 slug 예) openrouter/anthropic/claude-sonnet-4 | openai/gpt-4o | gemini/gemini-2.0-flash | anthropic/claude-sonnet-4-5 
LLM_MODEL=
# 키 값 1개(provider 무관). config api_key_env 기본이 이 이름을 가리킨다.
LLM_API_KEY=
#LLM_API_KEY_ENV=          # (선택) 

# 비밀값 — 서버 밖 반출 금지 (관례키 재사용 시 사용; 별도 .env.openrouter 로도 가능)
#OPENROUTER_API_KEY=
ARIA_KEY=
