# MDG defense agent container (FRAMEWORK_STACK §4 · PS-4/PS-5).
# base pinned to server-live Python (3.12.3). Local 3.14 pip-free goal is dropped
# (replay JSONL is the portability line, D-2).
FROM python:3.12-slim

# tool binaries: nsenter(util-linux), iproute2(ss/ip), tcpdump. docker CLI via
# docker-socket-proxy (PS-1) — NOT the raw socket. air image lacks curl -> httpx.
RUN apt-get update && apt-get install -y --no-install-recommends \
        util-linux iproute2 tcpdump ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# supply-chain: hash-pinned install (PS-4). requirements.lock generated by
# pip-compile --generate-hashes; falls back to requirements.txt in dev.
COPY requirements.txt requirements.lock* /app/
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
    || pip install --no-cache-dir -r requirements.txt

COPY . /app/mdg/
ENV PYTHONPATH=/app

# non-root (host-root agent hardening). Secrets via tmpfs 0400 mount at runtime
# (PS-5) — never baked into layers. egress allowlist = api.anthropic.com only (PS-4,
# applied at compose/iptables — operator-go 유보).
RUN useradd -m -u 10001 mdg && chown -R mdg:mdg /app
USER mdg

# GATE0 self-check on build: run the verify-suite (no live state change).
RUN python mdg/verify/verify_tools.py \
    && python mdg/verify/verify_graph.py \
    && python mdg/verify/verify_routing.py \
    && python mdg/verify/verify_grep0.py \
    && python mdg/verify/verify_keys.py \
    && python mdg/verify/verify_no_fw_subproc.py \
    && python mdg/tests/test_math.py

# driver entrypoint (out-of-graph while loop). allow_live defaults False (operator-go).
CMD ["python", "-m", "mdg.core.driver"]
