# defense_agent 배포 설정 — 이 파일을 .env 로 복사 후 값 채움 (.env 는 gitignore).
#   `cp .env.example .env` 후 값 채움. dah.sh 가 .env 를 자동 로드하고(set -a),
#   TESTBED=${TESTBED_USER}@${TESTBED_HOST} + SSH_KEY 를 export 해 live/*.sh 에 전달.
#   ★ 온-호스트(오프라인) 실행(verify/test/campaign/autorun-dry)에는
#     TESTBED_*/SSH_KEY 불필요 — live/status 서브커맨드에서만 사용.

# 테스트베드 접속 (live/status 전용 · 온-호스트면 비워둠). ★값에 < > 금지 — bash .env 소싱이 깨짐.
#   예: TESTBED_HOST=43.203.160.4   SSH_KEY=~/.ssh/key.pem
TESTBED_HOST=
TESTBED_USER=ubuntu
SSH_KEY=

# ── LLM(orient/decide advisory) — 키 1개 + 모델 slug 2개만 채우면 "아무 플랫폼"에서 동작 ──
#   비밀값(서버 밖 반출 금지). 비워도 코어는 결정론 폴백으로 안전 동작(advisory 침묵).
#   litellm 이 모델 slug 접두로 provider 라우팅(openrouter/… · anthropic/… · openai/… · gemini/…)하고,
#   MDG_LLM_API_KEY 값을 명시 주입하므로 하나의 키로 어떤 provider 든 인증된다.
#   ★★ 값은 '=' 바로 뒤에 공백 없이 붙여 쓰세요. "= 뒤 공백"은 bash sourcing 오류(값이 명령으로 실행됨). 따옴표도 금지.
#        올바름:  MDG_LLM_API_KEY=sk-or-abc123
#        틀림:    MDG_LLM_API_KEY= sk-or-abc123     ← '=' 뒤 공백
# 키 값 1개(provider 무관: OpenRouter/Anthropic/OpenAI/Gemini). 로그·프롬프트 미노출.
MDG_LLM_API_KEY=
# 모델 slug 예) openrouter/anthropic/claude-sonnet-4.5 | openai/gpt-4o-mini | gemini/gemini-2.0-flash | anthropic/claude-sonnet-4-5
MDG_ORIENT_MODEL=
# 모델 slug 예) openrouter/anthropic/claude-opus-4.1 | openai/gpt-4o | anthropic/claude-sonnet-4-5
MDG_DECIDE_MODEL=
#MDG_LLM_API_KEY_ENV=      # (선택) 키를 관례적 이름으로 둘 때 그 이름 지정(예: OPENAI_API_KEY). MDG_LLM_API_KEY 자기지정보다 우선.
#MDG_ORIENT_FALLBACK=      # (선택) 콤마 slug 목록. ''=yaml 폴백 제거(provider 교체 시 동일 provider slug).
#MDG_DECIDE_FALLBACK=      # (선택) 콤마 slug 목록. ''=제거.
# (관례 키 직접 사용도 가능 — models.yaml api_key_env 가 가리키면 됨)
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=

# operator-go 게이트 — 미설정/blank/0/false 면 모든 actuation DRY(관측 read-only).
#   1(truthy) 로 두면 live/autorun 이 단일 가역 DROP 집행 창을 개방(명시 승인용).
#   ★샌드박스/SITL 데모 기본값=1(자율 복구 관람). 실기체/프로덕션은 0 으로 되돌릴 것.
MDG_ALLOW_LIVE=1

# operator 자동승인 게이트 — 미설정/blank/0/false 면 OPER 티어(docker_pause/send_signed_mode)는
#   escalate(사람 승인 대기, 자동집행 안 함). 1 이면 샌드박스 자동집행.
#   ★기본값=0(권장): OPER 자동집행이 web_backend pause 등으로 대시보드/관측을 끊는 부작용을 막는다.
#   5762 공방전 핵심 복구(backdoor_drop=nsenter DROP)는 AUTO 티어라 이 값과 무관하게 계속 자율집행됨.
#   서명복구(드론 30m 자동복귀)까지 완전자율로 보고 싶을 때만 1 로(단 OPER 부작용 감수).
MDG_OPERATOR_AUTO=0

# 뷰어 bearer 토큰 (PS-8, fail-secure): ★비우면 dah.sh viewer 가 랜덤토큰을 자동생성하고 접속 URL 출력
#   (그 URL 을 브라우저에 붙이면 됨). 고정 토큰 원하면 값 지정 → 접속은 http://.../?token=<그값>.
MDG_VIEWER_TOKEN=

# (선택) 리포트 호스트 라벨 — 비우면 코드 기본값으로 IP 미노출. (값에 < > 금지)
MDG_TESTBED_LABEL=
