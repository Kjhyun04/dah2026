# DAH testbed v2 — 환경설정 예시
# 사용: cp .env.example .env  후 비밀값 채움. .env 는 커밋 금지.
# (설정 사양 문서는 아카이브 분리됨)

# ── 셀룰러 / 가입자 (⚠ 테스트값 — 실제 방산 적용 시 교체) ──
PLMN_MCC=001
PLMN_MNC=01
TAC=7
IMSI=001010000000001
UE_KEY=00112233445566778899aabbccddeeff
UE_OPC=63bfa50ee6523365ff14c1f45f88737d
APN=internet
UE_POOL=10.45.0.0/16
UE_GW=10.45.0.1

# ── SGi("인터넷") 망 ──
SGI_CIDR=172.30.0.0/24
GCS_IP=172.30.0.10
WEB_BACKEND_IP=172.30.0.20

# ── 포트맵 ──
MAV_PLAIN_PORT=14550
ARIA_CIPHER_PORT=14555
GPS_INPUT_PORT=14540
FANOUT_PORT=14560
WEB_HTTP_PORT=8080
WEB_WS_PORT=8081

# ── 암호 ──
PDCP_EEA=EEA2
PDCP_EIA=EIA2
ARIA_KEY_HEX=            # 64 hex(32B). 생성: openssl rand -hex 32  (비커밋!)
ARIA_MTU_CLAMP=1200

# ── GPS ──
GPS_RATE_HZ=10
